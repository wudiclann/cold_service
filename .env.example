# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real keys.

# Public — safe to expose to the client, protected by Supabase RLS.
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — DO NOT expose to client / DO NOT commit.
# Get this from: Supabase Dashboard -> Project Settings -> API -> service_role secret
# API routes that mutate orders/status_history/final_amount need this to work.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — DO NOT expose to client / DO NOT commit.
# Get this from: https://platform.openai.com/api-keys
# Powers the AI Operations Query widget on the Manager dashboard
# (app/api/ai/query/route.ts). Without it, the widget degrades gracefully
# with an explanatory message instead of crashing.
OPENAI_API_KEY=
